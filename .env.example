# NESSUNA di queste variabili è obbligatoria.
# Senza chiavi il sito funziona lo stesso, in modalità fallback.

# Statistiche e calendario (football-data.org, piano gratuito)
FOOTBALL_DATA_API_KEY=

# Quote reali (the-odds-api.com, piano gratuito)
ODDS_API_KEY=

# Protezione dell'endpoint cron. Se vuoto, l'endpoint resta aperto.
CRON_SECRET=

# Parametri del motore
DAILY_CREDITS_BUDGET=10
MIN_EDGE_PERCENT=5
MAX_PICKS_PER_DAY=3
